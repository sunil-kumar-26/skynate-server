<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Welcome to Skynate</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f4f6f8;
        padding: 20px;
        display: flex;
        justify-content: center;
      }
      .box {
        max-width: 600px;
        margin: auto;
        background: #fff;
        border-radius: 6px;
      }
      .header {
        background: #ffffff;
        color: #fff;
        padding: 20px;
        text-align: center;
      }
      .content {
        padding: 30px;
        color: #333;
      }
      .footer {
        text-align: center;
        font-size: 12px;
        color: #777;
        padding: 15px;
      }
      .img {
        width: 100%;
        height: 100%;
      }
      a {
        text-decoration: none;
      }
      button {
        background-color: white;
        color: #333;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="box">
      <div class="header">
        <h2>Welcome to Skynate</h2>
        <a href="https://skynateai.netlify.app/"
          ><button>Visit skynate</button></a
        >
      </div>
      <img src="https://i.imgur.com/pMUTZsQ.png" alt="skynate" class="img" />
      <div class="content">
        <p>Hi <strong><%= email %></strong>,</p>

        <p>Your account has been successfully created on <b>Skynate</b>.</p>

        <p>If you didn’t sign up, you can safely ignore this email.</p>
      </div>

      <div class="footer">© <%= new Date().getFullYear() %> Skynate</div>
    </div>
  </body>
</html>
